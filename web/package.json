    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
