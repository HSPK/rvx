{
  "name": "rvx-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.login.config.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
